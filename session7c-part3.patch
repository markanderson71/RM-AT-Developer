     quote: lead.quote, intent_referenced_quote: lead.reference_quote,
   };
 }
+
+/**
+ * DIRT qualification (session 7c). Chris scored a5v6zxm's desired performance 2 and sjm4bip's 3 on inventories the
+ * clerk could not tell apart: sjm4bip said "varying the RATE of extension and flexion", a5v6zxm said "ACTIVE extension
+ * and flexion" — "active how?" A movement described by its Duration, Intensity, Rate or Timing is specific; one
+ * described by an adjective (active, strong, good, proper, effective, dynamic) is not. Lexical, so it is logged, not
+ * hidden: `dirt_terms` lists what matched, `dirt_qualified` is whether anything did. Adjectives never count.
+ * Known limit: it is per passage, not per movement — a5v6zxm still qualifies on "through all phases" (a duration on
+ * recentering) while its extension/flexion is only "active". The evaluator sees the terms and judges the movement;
+ * the term list was written before it was run on these two quotes and is not tuned to separate them.
+ */
+const DIRT_RE = /\b(rate|timing|duration|intensity|vary(?:ing|ies)?|varied|faster|slower|quicker|earlier|later|sooner|longer|shorter|gradual(?:ly)?|progressive(?:ly)?|continuous(?:ly)?|throughout the (?:whole|entire )?turn|through all phases|(?:more|less) (?:rapid|gradual|abrupt|sustained))\b/gi;
+export const dirtTerms = (text) => [...new Set((String(text || '').match(DIRT_RE) || []).map((t) => t.toLowerCase()))];
+export function dirtFacts(x) {
+  if (!x || typeof x !== 'object') return x;
+  const dp = x.desired_performance;
+  if (dp && typeof dp === 'object') { const t = dirtTerms(dp.quote); dp.dirt_terms = t; dp.dirt_qualified = t.length > 0; }
+  const rx = x.prescription;
+  if (rx && typeof rx === 'object') { const t = dirtTerms([rx.delivery_to_peer, rx.rationale_to_examiner, rx.task].filter(Boolean).join(' ')); rx.dirt_terms = t; rx.dirt_qualified = t.length > 0; }
+  return x;
+}

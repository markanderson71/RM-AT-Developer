+          {e.videoUrl && <div style={{ marginBottom: 14 }}><SectionLabel>Video</SectionLabel><a href={e.videoUrl} target="_blank" rel="noreferrer" style={{ color: C.blue, fontSize: 14, wordBreak: "break-all" }}>{e.videoUrl}</a></div>}

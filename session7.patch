+              <div style={{ display: "flex", gap: 4, flexWrap: "wrap" }}>{e.connectionTags.map((id) => { const d = DOMAINS.find((x) => x.id === id); return d ? <Tag key={id} d={d} big /> : null; })}</div>
+            </div>

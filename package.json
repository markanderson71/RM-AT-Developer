{
  "name": "at-development-tracker",
  "private": true,
  "version": "1.1.0",
  "description": "Alpine Trainer Development Tracker — Mark · PSIA-RM · Keystone",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "migrate": "node scripts/migrate.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:dry": "node scripts/bootstrap.mjs --dry-run",
    "search": "node scripts/search.mjs",
    "score": "node scripts/score.mjs",
    "session4:migrate": "node scripts/session4-migrate.mjs",
    "test:score": "node scripts/selftest-score.mjs",
    "test:exam": "node scripts/selftest-exam.mjs",
    "test:history": "node scripts/selftest-history.mjs",
    "zoom": "node scripts/zoom.mjs",
    "test:zoom": "node scripts/selftest-zoom.mjs",
    "ingest:scores": "node scripts/ingest-scores.mjs",
    "test:ingest": "node scripts/selftest-ingest.mjs",
    "test:journal": "node scripts/selftest-journal.mjs",
    "migrate:sheet": "node scripts/migrate-sheet.mjs",
    "test:ops": "node scripts/selftest-ops.mjs",
    "test:progress": "node scripts/selftest-progress.mjs",
    "render:progress": "npx esbuild scripts/rendertest-progress.jsx --bundle --platform=node --format=esm --jsx=automatic --loader:.js=jsx --external:react --external:react-dom --outfile=_rtp.mjs --log-level=warning && node _rtp.mjs; rm -f _rtp.mjs"
  },
  "dependencies": {
